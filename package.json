{
  "name": "catering-service-marketplace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "node server/index.js",
    "dev:api:lan": "node -e \"process.env.HOST='0.0.0.0'; import('./server/index.js')\"",
    "dev:mobile": "concurrently \"npm:dev:api:lan\" \"npm --prefix mobile start\"",
    "mobile:install": "npm --prefix mobile install",
    "mobile:source-check": "node scripts/check-mobile-source.mjs",
    "mobile:typecheck": "npm --prefix mobile run typecheck",
    "mobile:doctor": "npm --prefix mobile run doctor",
    "db:check": "node server/check-db.js",
    "db:verify-mobile": "node scripts/verify-local-mobile-db.mjs",
    "test:mobile-api": "node scripts/smoke-mobile-api.mjs",
    "build": "tsc && vite build",
    "start": "node server/index.js",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.179.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^8.2.2",
    "typescript": "^5.9.3",
    "vite": "^6.4.3"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.24.0",
    "mysql2": "^3.22.6",
    "nodemailer": "^9.0.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "three": "^0.179.1",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  }
}
