DB_MODE=mysql
DATABASE_URL=mysql://<cloud-user>:<cloud-password>@<cloud-host>:<cloud-port>/<cloud-database>
# Optional: set MYSQL_CREATE_DATABASE=true only when DATABASE_URL has no database path.
MYSQL_SSL=true
MYSQL_SSL_REJECT_UNAUTHORIZED=true
MYSQL_MAX_ALLOWED_PACKET=67108864
JWT_SECRET=<long-random-secret>
JWT_EXPIRES_IN=2h
MFA_REQUIRED=true
MFA_CODE_SECRET=<different-long-random-secret>
MFA_CODE_TTL_MINUTES=10
MFA_MAX_ATTEMPTS=5
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=<dedicated-demo-mailbox@gmail.com>
SMTP_PASS=<gmail-app-password>
SMTP_FROM=FeastFlow <dedicated-demo-mailbox@gmail.com>
SERVE_CLIENT=true
VAPID_SUBJECT=mailto:admin@example.com
VAPID_PUBLIC_KEY=<public-vapid-key>
VAPID_PRIVATE_KEY=<private-vapid-key>
