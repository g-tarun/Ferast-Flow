DB_MODE=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=feastflow_local
MYSQL_MAX_ALLOWED_PACKET=67108864
MYSQL_SSL=false
MYSQL_SSL_REJECT_UNAUTHORIZED=true
JWT_SECRET=change-this-local-secret
JWT_EXPIRES_IN=2h
API_PORT=4000
SERVE_CLIENT=true
