DB_MODE=mysql
# Optional: use DATABASE_URL instead of the individual MYSQL_* values below.
# DATABASE_URL=mysql://root:your_mysql_password@127.0.0.1:3306/feastflow_local
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=feastflow_local
MYSQL_CREATE_DATABASE=true
MYSQL_MAX_ALLOWED_PACKET=67108864
MYSQL_SSL=false
MYSQL_SSL_REJECT_UNAUTHORIZED=true
JWT_SECRET=change-this-local-secret
JWT_EXPIRES_IN=2h
AUTH_LOGIN_RATE_LIMIT=40
AUTH_LOGIN_RATE_WINDOW_MS=300000
AUTH_REGISTER_RATE_LIMIT=12
AUTH_REGISTER_RATE_WINDOW_MS=900000
# Set to true only after SMTP is configured. Gmail works for a free demo with an App Password.
MFA_REQUIRED=false
MFA_CODE_SECRET=change-this-mfa-code-secret
MFA_CODE_TTL_MINUTES=10
MFA_MAX_ATTEMPTS=5
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-demo-mailbox@gmail.com
SMTP_PASS=your-16-digit-google-app-password
SMTP_FROM=FeastFlow <your-demo-mailbox@gmail.com>
API_PORT=4000
HOST=127.0.0.1
SERVE_CLIENT=true
VAPID_SUBJECT=mailto:admin@example.com
VAPID_PUBLIC_KEY=<generate-with-npx-web-push-generate-vapid-keys>
VAPID_PRIVATE_KEY=<generate-with-npx-web-push-generate-vapid-keys>
